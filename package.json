{
  "name": "game-launcher",
  "version": "1.0.0",
  "description": "Lightweight, customizable desktop game launcher for Windows",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "build:vite": "tsc --noEmit && vite build",
    "build:electron": "node build-electron.cjs",
    "build": "npm run build:vite && npm run build:electron",
    "dev": "concurrently -k -p \"[{name}]\" -n \"VITE,APP\" -c \"cyan,magenta\" \"vite\" \"node dev-electron.cjs\"",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "keywords": [
    "game-launcher",
    "steam",
    "epic-games",
    "gog",
    "electron",
    "react",
    "vite",
    "tailwind"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.ggl.gamelauncher",
    "productName": "GGL - Generic Game Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "electron/scripts/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GGL - Generic Game Launcher"
    }
  }
}
